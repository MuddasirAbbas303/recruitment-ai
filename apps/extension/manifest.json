{
  "manifest_version": 3,
  "name": "Recruitment AI LinkedIn Importer",
  "version": "1.0.0",
  "description": "Import visible LinkedIn profile results from the current Google search page.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://www.linkedin.com/*",
    "https://*.linkedin.com/*",
    "http://localhost:3000/*",
    "http://localhost:5173/*"
  ],
  "action": {
    "default_title": "Recruitment AI",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/in/*", "https://*.linkedin.com/in/*"],
      "js": ["linkedinProfileParser.js"],
      "run_at": "document_idle"
    }
  ]
}
